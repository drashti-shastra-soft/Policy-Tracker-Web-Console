@model PolicyTrackerWebClient.Domain.Payout

<div class="modal fade" id="modal-payout" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title h5">@(Model.Id > 0 ? "Edit Bank Credit" : "Add Bank Credit")</h1>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Broker <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.BrokerId, ViewBag.Brokers as List<SelectListItem>, "Select Broker", new { @class = "form-control", data_required = "Broker" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>For statement month</label>
                        <input type="month" name="statementMonthValue" class="form-control" value="@(Model.StatementMonth.HasValue ? Model.StatementMonth.Value.ToString("yyyy-MM") : "")" />
                        <small class="form-text text-muted">Leave blank if the broker hasn't said which month it is for.</small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label>Received on <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.ReceivedOn, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", data_required = "Date" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Amount received <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.AmountReceived, new { @class = "form-control", type = "number", step = "0.01", min = "0", data_required = "Amount" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>TDS rate %</label>
                        @Html.TextBoxFor(m => m.TdsRate, new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "Broker default" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Paid by (firm)</label>
                        @Html.TextBoxFor(m => m.PaidByFirm, new { @class = "form-control", placeholder = "If paid from another firm's account" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Remarks</label>
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit-payout">Submit</a>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_Notification", false)
<script>
    $(function () {
        $('.btn-submit-payout').on('click', function () { if (App.validate('#modal-payout')) $('#frmCreate').submit(); });
    });
</script>
