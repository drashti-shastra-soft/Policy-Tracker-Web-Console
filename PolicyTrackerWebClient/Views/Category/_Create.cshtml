@model PolicyTrackerWebClient.Domain.Category

<div class="modal fade" id="modal-category" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title h5">@(Model.Id > 0 ? "Edit Category" : "Add Category")</h1>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", data_required = "Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Default points %</label>
                        @Html.TextBoxFor(m => m.DefaultPoints, new { @class = "form-control", type = "number", step = "0.01" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label></label>
                        <div class="form-check mt-1">@Html.CheckBoxFor(m => m.IsMotor, new { @class = "form-check-input" })<label class="form-check-label" for="IsMotor">Motor (OD / TP split)</label></div>
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label" for="IsActive">Is Active?</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit-master">Submit</a>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_Notification", false)
<script>
    $(function () {
        $('#modal-category .btn-submit-master').on('click', function () {
            if (App.validate('#modal-category')) $('#frmCreate').submit();
        });
    });
</script>
