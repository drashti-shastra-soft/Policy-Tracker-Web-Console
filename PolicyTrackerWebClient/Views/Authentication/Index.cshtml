@model PolicyTrackerWebClient.Domain.Credential
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in | Policy Tracker</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/icheck-bootstrap/icheck-bootstrap.min.css")">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <span class="h1"><i class="fas fa-shield-alt text-primary"></i> <b>Policy</b>Tracker</span>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Sign in to start your session</p>

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                {
                    <div class="alert alert-danger py-2">@ViewBag.ErrorMessage</div>
                }

                @using (Html.BeginForm("Index", "Authentication", new { returnUrl = Request.QueryString["returnUrl"] }, FormMethod.Post, new { id = "frmLogin", autocomplete = "on" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="input-group mb-3">
                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Email", type = "email", required = "required", autofocus = "autofocus" })
                        <div class="input-group-append"><div class="input-group-text"><span class="fas fa-envelope"></span></div></div>
                    </div>
                    <div class="input-group mb-3">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password", required = "required", autocomplete = "current-password" })
                        <div class="input-group-append"><div class="input-group-text"><span class="fas fa-lock"></span></div></div>
                    </div>
                    <div class="row">
                        <div class="col-7">
                            <div class="icheck-primary">
                                @Html.CheckBoxFor(m => m.RememberMe)
                                <label for="RememberMe">Remember my email</label>
                            </div>
                        </div>
                        <div class="col-5">
                            <button type="submit" class="btn btn-primary btn-block">Sign In</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>
</body>
</html>
