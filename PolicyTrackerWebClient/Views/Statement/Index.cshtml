@model PolicyTrackerWebClient.Domain.StatementLineLister
@{
    ViewBag.Title = "Broker Statements";
}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6"><h1>Broker Statements</h1></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item active">Statements</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <!-- Import -->
        <div class="card card-primary card-outline collapsed-card" id="cardImport">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-upload mr-1"></i> Import the broker's commission Excel</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-plus"></i></button>
                </div>
            </div>
            <div class="card-body">
                <form id="frmImport" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-3 form-group">
                            <label>Broker <span class="text-danger">*</span></label>
                            @Html.DropDownList("brokerId", ViewBag.Brokers as List<SelectListItem>, new { @class = "form-control" })
                        </div>
                        <div class="col-md-3 form-group">
                            <label>Statement month</label>
                            <input type="month" name="statementMonth" class="form-control" />
                            <small class="form-text text-muted">The month written on the broker's sheet. Leave blank to use each policy's start month.</small>
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Excel file (.xlsx) <span class="text-danger">*</span></label>
                            <input type="file" name="file" accept=".xlsx" class="form-control-file" />
                        </div>
                        <div class="col-md-2 form-group">
                            <div class="form-check mt-md-4">
                                <input type="checkbox" class="form-check-input" id="replaceExisting" name="replaceExisting" value="true" />
                                <label class="form-check-label" for="replaceExisting">Replace that month</label>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Import</button>
                    <span class="text-muted small ml-2">Rows already imported are skipped automatically.</span>
                </form>
                <div id="importResult" class="mt-3" style="display:none"></div>
            </div>
        </div>

        <div class="card">
            @using (Ajax.BeginForm("List", "Statement", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
            {
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
            }
        </div>

        <div id="divCreate"></div>
    </section>
</div>

<script>
    $(function () {
        $('#frmImport').on('submit', function (e) {
            e.preventDefault();
            var fd = new FormData(this);
            if (!fd.get('replaceExisting')) fd.append('replaceExisting', 'false');
            var file = this.file.files[0];
            if (!file) { App.toast('error', "Please choose the broker's Excel (.xlsx) file."); return; }

            App.loading(true);
            $.ajax({ url: '@Url.Action("Import", "Statement")', type: 'POST', data: fd, processData: false, contentType: false, dataType: 'json' })
                .done(function (data) {
                    App.notify(data);
                    var r = data.Result;
                    if (r) {
                        var html = '<div class="alert alert-light border mb-0"><strong>' + r.Imported + '</strong> imported, ' + r.Skipped + ' skipped (already there) of ' + r.TotalRows + ' rows.';
                        if (r.Warnings && r.Warnings.length) {
                            html += '<div class="mt-2 text-warning"><i class="fas fa-exclamation-triangle"></i> Check these rows:</div><ul class="small mb-0">';
                            $.each(r.Warnings, function (i, w) { html += '<li>' + $('<div/>').text(w).html() + '</li>'; });
                            html += '</ul>';
                        }
                        html += '</div>';
                        $('#importResult').html(html).show();
                        $('#frmImport')[0].reset();
                        App.refreshList();
                    }
                })
                .always(function () { App.loading(false); });
        });

        $(document).off('click', '.icon-link').on('click', '.icon-link', function () { App.openModal('@Url.Action("Link", "Statement")/' + $(this).data('id')); });
        $(document).off('click', '.icon-unlink').on('click', '.icon-unlink', function () { App.action('@Url.Action("Unlink", "Statement")/' + $(this).data('id'), 'Unlink this statement line from its policy?'); });
        $(document).off('click', '.icon-create-policy').on('click', '.icon-create-policy', function () {
            App.action('@Url.Action("CreatePolicy", "Statement")/' + $(this).data('id'), 'Create a policy from this statement line? (Use this for policies that are on the statement but missing from your register.)');
        });
        $(document).off('click', '.icon-delete').on('click', '.icon-delete', function () { App.action('@Url.Action("Delete", "Statement")/' + $(this).data('id'), 'Delete this statement line?'); });
        $(document).off('click', '.btn-rematch').on('click', '.btn-rematch', function () {
            App.action('@Url.Action("Rematch", "Statement")?brokerId=' + ($('#SearchCriteria_BrokerId').val() || ''));
        });
    });
</script>
