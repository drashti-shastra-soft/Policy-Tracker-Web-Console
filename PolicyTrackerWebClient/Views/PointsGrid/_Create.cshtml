@model PolicyTrackerWebClient.Domain.PointsGrid

<div class="modal fade" id="modal-pointsgrid" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title h5">@(Model.Id > 0 ? "Edit Points Grid Row" : "Add Points Grid Row")</h1>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Broker <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.BrokerId, ViewBag.Brokers as List<SelectListItem>, "Select Broker", new { @class = "form-control", data_required = "Broker" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Category <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.CategoryId, ViewBag.Categories as List<SelectListItem>, "Select Category", new { @class = "form-control", data_required = "Category" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 form-group">
                        <label>Eldest age from <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.AgeFrom, new { @class = "form-control", data_required = "Age from", type = "number", step = "1" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Eldest age to <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.AgeTo, new { @class = "form-control", data_required = "Age to", type = "number", step = "1" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>Points % <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Points, new { @class = "form-control", data_required = "Points", type = "number", step = "0.01" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label" for="IsActive">Is Active?</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit-master">Submit</a>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_Notification", false)
<script>
    $(function () {
        $('#modal-pointsgrid .btn-submit-master').on('click', function () {
            if (App.validate('#modal-pointsgrid')) $('#frmCreate').submit();
        });
    });
</script>
