@model PolicyTrackerWebClient.Domain.BrokerLister
@{
    ViewBag.Title = "Brokers";
}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6"><h1>Brokers</h1></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item active">Brokers</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="card">
            @using (Ajax.BeginForm("List", "Broker", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
            {
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
            }
        </div>

        @using (Ajax.BeginForm("Create", "Broker", new AjaxOptions() { UpdateTargetId = "divCreate", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmCreate" }))
        {
            <div id="divCreate"></div>
        }
    </section>
</div>

<script>
    $(function () {
        $(document).off('click', '.add-broker').on('click', '.add-broker', function () { App.openModal('@Url.Action("Create", "Broker")'); });
        $(document).off('click', '.icon-edit').on('click', '.icon-edit', function () { App.openModal('@Url.Action("Get", "Broker")/' + $(this).data('id')); });
        $(document).off('click', '.icon-delete').on('click', '.icon-delete', function () { App.action('@Url.Action("Delete", "Broker")/' + $(this).data('id'), 'Delete this broker?'); });
    });
</script>
